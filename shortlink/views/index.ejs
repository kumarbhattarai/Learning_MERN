<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
</head>
<body>
    <h1>URL Shortener</h1>

    <form method="post" action="/url">
        <label>Enter the URL</label>
        <input type="text" name="url" placeholder="https://example.com">
        <button type="submit">Generate</button>
    </form>
    <%if (locals.id) {%>
        <p>URL generated (copy the whole url, replace 'localhost' with 'ip address and port' given to you by the creator and paste it to your browser):</p>
        <p> localhost:3000/url/<%= id %></p>
    <%} %>
    <div>
        <%if (locals.urls) {%>
            <table>
             <thead>
                <th>SN.</th>
                <th>shortid</th>
                <th>redirect</th>
                <th>total clicks</th>
             </thead>
             <tbody>
                <% urls.forEach((url,index) => { %>
                 <tr>
                    <td><%= index+1 %></td>
                    <td><%= url.shortid %></td>
                    <td><%= url.redirecturl%></td>
                    <td><%= url.History.length%></td>
                 </tr>
                <% }) %>
             </tbody>

            </table>
            <%} %>
    </div>
</body>
</html>